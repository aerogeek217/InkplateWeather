{% set t = ctx.trend %}
{% set font = "Inter Tight, Arial, sans-serif" %}
      <div style="display: flex; flex-direction: column; gap: 4px; border-top: 2px solid #000000; padding-top: 10px">
        <svg width="504" height="85" viewBox="0 0 544 92" role="img" aria-label="{{ t.aria_label }}">
{% if t.gridlines %}
          <path d="{% for y, _ in t.gridlines %}{% if not loop.first %} {% endif %}M30,{{ y }} H540{% endfor %}" stroke="#DBDBDB" stroke-width="1"></path>
{% endif %}
{% if t.midnights %}
          <path d="{% for x in t.midnights %}{% if not loop.first %} {% endif %}M{{ x }},0 V70{% endfor %}" stroke="#929292" stroke-width="1" stroke-dasharray="2 3"></path>
{% endif %}
          <g font-family="{{ font }}" font-size="11" fill="#494949" text-anchor="end">
            {% for y, label in t.gridlines %}<text x="24" y="{{ (y + 3) | round(2) }}">{{ label }}</text>{% endfor %}

          </g>
{% if t.past %}
          <path d="M{% for x, y in t.past %}{{ x }},{{ y }} L{% endfor %}{{ t.past[-1][0] }},70 L{{ t.past[0][0] }},70 Z" fill="#DBDBDB"></path>
          <polyline points="{% for x, y in t.past %}{% if not loop.first %} {% endif %}{{ x }},{{ y }}{% endfor %}" fill="none" stroke="#000000" stroke-width="2.7" stroke-linejoin="round"></polyline>
{% endif %}
{% if t.future | length > 1 %}
          <polyline points="{% for x, y in t.future %}{% if not loop.first %} {% endif %}{{ x }},{{ y }}{% endfor %}" fill="none" stroke="#000000" stroke-width="2.7" stroke-dasharray="5 4" stroke-linejoin="round"></polyline>
{% endif %}
          <path d="M30,70 H540" stroke="#000000" stroke-width="1"></path>
{% for x, w in t.nights %}
          <rect x="{{ x }}" y="72" width="{{ w }}" height="4" fill="#000000"></rect>
{% endfor %}
{% if t.now %}
          <path d="M{{ t.now[0] }},0 V70" stroke="#000000" stroke-width="1.5"></path>
          <circle cx="{{ t.now[0] }}" cy="{{ t.now[1] }}" r="5" fill="#000000" stroke="#FFFFFF" stroke-width="2"></circle>
{% endif %}
          <g fill="#000000">
            {% for p in t.points %}<circle cx="{{ p[0] }}" cy="{{ p[1] }}" r="3"></circle>{% endfor %}

          </g>
          <g font-family="{{ font }}" font-size="12" font-weight="700" fill="#000000" text-anchor="middle">
            {% for p in t.points %}<text x="{{ p[2] }}" y="{{ p[3] }}">{{ p[4] }}</text>{% endfor %}

          </g>
          <g font-family="{{ font }}" font-size="11.5" font-weight="700" fill="#494949">
            {% for x, label in t.day_labels %}<text x="{{ x }}" y="88">{{ label }}</text>{% endfor %}

          </g>
{% if t.now %}
          <text x="{{ t.now[0] }}" y="88" text-anchor="middle" font-family="{{ font }}" font-size="11.5" font-weight="800" fill="#000000">NOW</text>
{% endif %}
        </svg>
      </div>
