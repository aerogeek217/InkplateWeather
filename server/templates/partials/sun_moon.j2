{% set s = ctx.sun %}
{% set m = ctx.moon %}
      <div style="display: grid; grid-template-columns: 236px minmax(0, 1fr); column-gap: 0; border-top: 2px solid #000000; padding-top: 8px">
        <div style="display: flex; flex-direction: column; gap: 2px; padding-right: 14px">
{% if s.message %}
          <div style="height: 72px; display: flex; align-items: center; font-size: 15px; font-weight: 600; color: #494949">{{ s.message }}</div>
{% else %}
          <svg width="222" height="52" viewBox="0 0 230 54" role="img" aria-label="{{ s.aria_label }}">
            <defs>
              <pattern id="htGround" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="#929292" stroke-width="1.2"></line></pattern>
            </defs>
            <rect x="0" y="46" width="230" height="8" fill="url(#htGround)"></rect>
            <path d="M0,46 H230" stroke="#000000" stroke-width="2"></path>
            <path d="M14,46 A101,36 0 0 1 216,46" fill="none" stroke="#929292" stroke-width="1.2" stroke-dasharray="3 4"></path>
{% if s.arc_end %}
            <path d="M14,46 A101,36 0 0 1 {{ s.arc_end[0] }},{{ s.arc_end[1] }}" fill="none" stroke="#000000" stroke-width="2.5"></path>
{% endif %}
            <path d="M14,40 V52 M216,40 V52" stroke="#000000" stroke-width="2"></path>
            <text x="115" y="41" text-anchor="middle" font-family="Inter Tight, Arial, sans-serif" font-size="11" font-weight="600" fill="#494949">{{ s.day_length }}</text>
{% if s.arc_end %}
            <g transform="translate({{ s.arc_end[0] }},{{ s.arc_end[1] }})">
              <circle cx="0" cy="0" r="13" fill="#FFFFFF"></circle>
              {{ icon_inner("markers/sun-on-arc") }}
            </g>
{% endif %}
          </svg>
          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; font-weight: 700">
            <span>↑ {{ s.rise }}</span><span style="font-size: 11px; font-weight: 400; color: #494949">{{ s.delta }}</span><span>↓ {{ s.set }}</span>
          </div>
{% endif %}
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px; padding-left: 14px; border-left: 1px solid #B6B6B6">
{% if m.message %}
          <div style="height: 72px; display: flex; align-items: center; font-size: 15px; font-weight: 600; color: #494949">{{ m.message }}</div>
{% else %}
          <div style="display: flex; gap: 10px; align-items: center">
            <svg width="36" height="36" viewBox="-28 -28 56 56" role="img" aria-label="{{ m.aria_label }}">
              <circle cx="0" cy="0" r="25" fill="#FFFFFF" stroke="#000000" stroke-width="2.5"></circle>
              <g fill="none" stroke="#B6B6B6" stroke-width="1.5"><circle cx="-5" cy="-7" r="5"></circle><circle cx="8" cy="5" r="3.5"></circle><circle cx="2" cy="14" r="2.5"></circle></g>
{% if m.shadow_path %}
              <path d="{{ m.shadow_path }}" fill="#000000"></path>
{% endif %}
            </svg>
            <div style="display: flex; flex-direction: column; gap: 1px">
              <span style="font-size: 15px; font-weight: 700">{{ m.illumination }} · {{ m.phase_name }}</span>
              <span style="font-size: 12px; color: #494949">{{ m.rise_set }}</span>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; font-size: 11px">
{% for ph in m.next %}{% set mi = moon_small[ph.kind] %}
            <span style="display: flex; gap: 4px; align-items: center">{{ icon_svg(mi[0], 13, label=mi[1]) }}<span><span style="font-weight: 700">{{ ph.label }}</span> {{ ph.date }}</span></span>
{% endfor %}
          </div>
{% endif %}
        </div>
      </div>
