{# Stale: value in #6D6D6D; its "as of" goes to the notes box (no room in a ~100 px cell). Missing: "No data" over a
   short cause ("since 1:12 PM"), two 13 px lines (line-height 1) in the height of the 24 px value line. #}
{% macro slot_value(s, size, weight, sub_size) -%}
{% if s.text %}<span style="font-size: {{ size }}px; font-weight: {{ weight }}; line-height: 1.1{% if s.status == 'stale' %}; color: #6D6D6D{% endif %}">{{ s.text }}{% if s.sub %} <span style="font-size: {{ sub_size }}px; font-weight: 400; color: #494949">{{ s.sub }}</span>{% endif %}</span>{% else %}<span style="display: flex; flex-direction: column; font-size: 13px; line-height: 1; white-space: nowrap"><span style="font-weight: 700">{{ s.message or "" }}</span>{% if s.sub %}<span style="color: #494949">{{ s.sub }}</span>{% endif %}</span>{% endif %}
{%- endmacro %}
      <div style="display: grid; grid-template-columns: repeat(5, auto); column-gap: 0; border-top: 2px solid #000000; padding-top: 8px">
{% for cell in ctx.readings %}
{% if loop.first %}{% set pad = "padding-right: 8px; white-space: nowrap" %}{% elif loop.last %}{% set pad = "padding-left: 8px; white-space: nowrap; border-left: 1px solid #B6B6B6" %}{% else %}{% set pad = "padding: 0 8px; white-space: nowrap; border-left: 1px solid #B6B6B6" %}{% endif %}
        <div style="display: flex; flex-direction: column; gap: 1px; {{ pad }}"><span style="font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase">{{ cell.label }}</span>{{ slot_value(cell.slot, 24, 700, 13) }}</div>
{% endfor %}
      </div>
